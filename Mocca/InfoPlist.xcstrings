{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手仅在你明确要求时读取或创建日历事件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistants read or create calendar events only when you explicitly ask."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照发送给 AI 模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos to send to your AI model."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你询问本地天气时使用当前位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location when you ask about local weather."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将聊天中的图片存储到照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save images from chats to Photos."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择头像、聊天背景或需要发送给助手的图片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose avatars, chat backgrounds, or images to send to your assistant."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手仅在你明确要求时查看或编辑提醒事项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistants view or edit reminders only when you explicitly ask."
          }
        }
      }
    }
  },
  "version": "1.0"
}
